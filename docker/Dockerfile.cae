# -----------------------------------------------------------------------------
# Stage 1: install dependencies (CPU-only PyTorch to save ~500MB+ per image)
# -----------------------------------------------------------------------------
FROM python:3.10-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY requirements-docker.txt .
RUN pip install --no-cache-dir -r requirements-docker.txt

# -----------------------------------------------------------------------------
# Stage 2: runtime image (slim + OpenGL for image processing)
# -----------------------------------------------------------------------------
FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY fl-payload/*.py ./
COPY fl-payload/models/ models/

RUN mkdir -p checkpoints plots data/payload/images/clean data/payload/images/noise

ENV FL_ROLE=client
ENV FL_CLIENT_ID=client_1
ENV FL_SERVER_URL=http://fl-server-cae:5544
ENV FL_CLEAN_DIR=/app/data/payload/images/clean
ENV FL_NOISY_DIR=/app/data/payload/images/noise
ENV FL_NUM_ROUNDS=10
ENV FL_LEARNING_RATE=0.001
ENV FL_BATCH_SIZE=32
ENV FL_EPOCHS_PER_ROUND=1
ENV FL_SERVER_HOST=0.0.0.0
ENV FL_SERVER_PORT=5544
ENV FL_NUM_CLIENTS=3
ENV FL_MIN_CLIENTS=2
ENV FL_AGGREGATION=fedavg
ENV FL_CLIENT_STAGGER_SEC=10
EXPOSE 5544

CMD ["sh", "-c", "\
    if [ \"$FL_ROLE\" = \"server\" ]; then \
        python fl_server.py \
            --host $FL_SERVER_HOST \
            --port $FL_SERVER_PORT \
            --num-clients $FL_NUM_CLIENTS \
            --min-clients $FL_MIN_CLIENTS \
            --aggregation $FL_AGGREGATION; \
    else \
        python fl_client_cae.py \
            --client-id $FL_CLIENT_ID \
            --clean-dir $FL_CLEAN_DIR \
            --noisy-dir $FL_NOISY_DIR \
            --server-url $FL_SERVER_URL \
            --num-rounds $FL_NUM_ROUNDS; \
    fi"]
